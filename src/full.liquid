<style>
  .tm { --s: 1; }
  .screen--lg .tm { --s: 1.5; }
  .tm { width: 100%; height: 100%; align-self: stretch; display: grid; gap: calc(8px * var(--s)); grid-template-columns: 308fr 186fr 286fr; grid-template-rows: 57fr 43fr;
        font-family: "Inter Variable", Inter, sans-serif; font-weight: 500; color: #000; }
  .tm * { box-sizing: border-box; }
  .tm .card { border: calc(1.5px * var(--s)) dotted #000; border-radius: calc(14px * var(--s)); padding: calc(10px * var(--s)) calc(12px * var(--s)); position: relative; overflow: hidden; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .tm .t { font-size: calc(13px * var(--s)); font-weight: 600; line-height: 1.2; }
  .tm .st { font-size: calc(9.5px * var(--s)); margin-top: calc(1px * var(--s)); line-height: 1.2; }
  .tm .num { font-weight: 300; letter-spacing: -0.03em; line-height: 1; }
  .tm .badge { display: inline-flex; align-items: center; gap: calc(4px * var(--s)); font-size: calc(9.5px * var(--s)); border-radius: calc(999px * var(--s)); padding: calc(2px * var(--s)) calc(7px * var(--s)); white-space: nowrap; line-height: 1.2; }
  .tm .badge svg { width: calc(10px * var(--s)); height: calc(10px * var(--s)); }
  .tm .badge--dark { background: #000; color: #fff; }
  .tm .badge--soft { border: calc(1px * var(--s)) solid #000; }
  .tm .badge--line { border: calc(1px * var(--s)) dashed #000; }

  .tm .car .name { font-size: calc(20px * var(--s)); font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
  .tm .car img { position: absolute; left: calc(4px * var(--s)); right: calc(4px * var(--s)); top: calc(48px * var(--s)); width: calc(100% - calc(8px * var(--s))); height: calc(100% - calc(92px * var(--s))); object-fit: contain !important; object-position: center bottom !important; }
  .tm .car .floor { position: absolute; left: calc(20px * var(--s)); right: calc(20px * var(--s)); bottom: calc(30px * var(--s)); height: calc(70px * var(--s)); border: calc(1px * var(--s)) dotted #000; border-radius: 50%; }
  .tm .car .state { position: absolute; bottom: calc(10px * var(--s)); left: 0; right: 0; display: flex; gap: calc(6px * var(--s)); align-items: center; justify-content: center; }
  .tm .car .state .badge { font-size: calc(10.5px * var(--s)); padding: calc(3px * var(--s)) calc(10px * var(--s)); }
  .tm .car .state .badge--dark svg { fill: #fff; }

  .tm .ring { position: relative; flex: 1; display: flex; align-items: center; justify-content: center; min-height: 0; }
  .tm .ring svg { height: 100%; aspect-ratio: 1; }
  .tm .ring .mid { position: absolute; text-align: center; }
  .tm .ring .mid .delta { font-size: calc(9px * var(--s)); min-height: calc(11px * var(--s)); }
  .tm .ring .mid .num { font-size: calc(40px * var(--s)); }
  .tm .ring .mid .num sup { font-size: calc(13px * var(--s)); font-weight: 500; vertical-align: calc(1px * var(--s)); margin-left: calc(1px * var(--s)); letter-spacing: 0; }
  .tm .ring .mid .num small { font-size: calc(11px * var(--s)); font-weight: 500; letter-spacing: 0; margin-left: calc(1px * var(--s)); }
  .tm .ring .mid .cap { font-size: calc(8.5px * var(--s)); margin-top: calc(3px * var(--s)); }
  .tm .legend { text-align: center; font-size: calc(9px * var(--s)); }

  .tm .kpis { display: grid; grid-template-rows: repeat(3, 1fr); gap: calc(8px * var(--s)); min-height: 0; }
  .tm .kpi { padding: calc(8px * var(--s)) calc(12px * var(--s)); }
  .tm .kpi .krow { display: flex; align-items: baseline; gap: calc(8px * var(--s)); margin-top: calc(3px * var(--s)); }
  .tm .kpi .num { font-size: calc(27px * var(--s)); }
  .tm .kpi .num small { font-size: calc(12px * var(--s)); font-weight: 500; letter-spacing: 0; margin-left: calc(2px * var(--s)); }
  .tm .dots { display: flex; justify-content: space-between; align-items: center; height: calc(6px * var(--s)); margin-top: auto; }
  .tm .dots span { width: calc(1.5px * var(--s)); height: calc(1.5px * var(--s)); background: #000; flex: none; }
  .tm .dots span.on { width: calc(3px * var(--s)); height: calc(6px * var(--s)); border-radius: calc(1px * var(--s)); }

  .tm .bottom { grid-column: 1 / -1; display: grid; gap: calc(8px * var(--s)); min-height: 0; grid-template-columns: calc(170px * var(--s)) 1fr calc(128px * var(--s)) calc(150px * var(--s)); }
  .tm .bottom--nogauge { grid-template-columns: 1fr calc(128px * var(--s)) calc(150px * var(--s)); }
  .tm .bottom .slist { grid-column: auto; }
    .tm .gauge .ring .mid .num { font-size: calc(30px * var(--s)); }

  .tm .slist .t { margin-bottom: 0; }
  .tm .srow { display: flex; align-items: center; gap: calc(10px * var(--s)); padding: calc(12px * var(--s)) 0; }
  .tm .srow + .srow { border-top: calc(1px * var(--s)) dotted #000; }
  .tm .ico { width: calc(26px * var(--s)); height: calc(26px * var(--s)); border-radius: calc(8px * var(--s)); flex: none; display: flex; align-items: center; justify-content: center; border: calc(1px * var(--s)) solid #000; }
  .tm .ico svg { width: calc(15px * var(--s)); height: calc(15px * var(--s)); fill: none; stroke: #000; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .tm .ico--on { background: #000; }
  .tm .ico--on svg { stroke: #fff; }
  .tm .srow .tx { flex: 1; min-width: 0; }
  .tm .srow .tx b { display: block; font-size: calc(11px * var(--s)); font-weight: 600; line-height: 1.25; }
  .tm .srow .tx span { display: block; font-size: calc(9px * var(--s)); line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .tm .stack { display: grid; grid-template-rows: 1fr 1fr; gap: calc(8px * var(--s)); min-height: 0; }
  .tm .mini { padding: calc(8px * var(--s)) calc(10px * var(--s)); }
  .tm .mini .inner { margin-top: auto; }
  .tm .mini .inner .num { font-size: calc(26px * var(--s)); }
  .tm .mini .inner span { display: block; font-size: calc(9px * var(--s)); margin-top: calc(2px * var(--s)); }

  .tm .tyres svg { width: 100%; flex: 1; min-height: 0; }
  .tm .tyres .foot { font-size: calc(9.5px * var(--s)); text-align: center; }
</style>

{%- comment %} ================= data ================= {%- endcomment %}
{%- assign now = trmnl.system.timestamp_utc | plus: 0 -%}
{%- assign tz = trmnl.user.utc_offset | plus: 0 -%}
{%- assign level = battery_level | plus: 0 -%}
{%- assign limit = 100 -%}{%- if charge_limit_soc -%}{%- assign limit = charge_limit_soc | plus: 0 -%}{%- endif -%}
{%- assign range_km = rated_battery_range_km | plus: 0 | round -%}
{%- assign odo_km = odometer | plus: 0 | round -%}
{%- assign kw = charger_power | plus: 0 -%}
{%- assign volts = charger_voltage | plus: 0 -%}
{%- assign speed_kmh = speed | plus: 0 | round -%}
{%- assign pwr = power | plus: 0 -%}
{%- assign t_in = inside_temp | plus: 0 | round -%}
{%- assign t_out = outside_temp | plus: 0 | round -%}

{%- assign is_charging = false -%}
{%- if state == 'charging' or charging_state == 'Charging' or charging_state == 'Starting' or kw > 0 -%}{%- assign is_charging = true -%}{%- endif -%}
{%- assign is_driving = false -%}
{%- if state == 'driving' -%}{%- assign is_driving = true -%}{%- endif -%}

{%- case state -%}
  {%- when 'charging' -%}{%- assign state_label = 'Laden' -%}
  {%- when 'driving' -%}{%- assign state_label = 'Rijdt' -%}
  {%- when 'asleep' -%}{%- assign state_label = 'Slaapt' -%}
  {%- when 'suspended' -%}{%- assign state_label = 'Valt in slaap' -%}
  {%- when 'offline' -%}{%- assign state_label = 'Offline' -%}
  {%- when 'updating' -%}{%- assign state_label = 'Update' -%}
  {%- else -%}{%- assign state_label = 'Geparkeerd' -%}
{%- endcase -%}
{%- if is_charging -%}{%- assign state_label = 'Laden' -%}{%- endif -%}
{%- assign place = '' -%}
{%- if geofence and geofence != '' and geofence != 'nil' -%}{%- assign place = geofence -%}{%- endif -%}

{%- assign fetched = reported_at | default: trmnl.plugin_settings.data_fetched_utc | plus: 0 -%}
{%- assign age_label = '' -%}
{%- if fetched > 0 -%}
  {%- assign age_min = now | minus: fetched | divided_by: 60 -%}
  {%- if age_min < 2 -%}{%- assign age_label = 'zojuist' -%}
  {%- elsif age_min < 60 -%}{%- capture age_label %}{{ age_min }} min geleden{% endcapture -%}
  {%- else -%}{%- capture age_label %}{{ age_min | divided_by: 60 }} uur geleden{% endcapture -%}
  {%- endif -%}
  {%- assign fetched_at = fetched | plus: tz | date: '%H:%M' -%}
{%- endif -%}
{%- assign since_label = '' -%}
{%- assign since_dur = '' -%}
{%- if since and since != '' -%}
  {%- assign since_s = since | date: '%s' | plus: 0 -%}
  {%- assign since_label = since_s | plus: tz | date: '%H:%M' -%}
  {%- assign dur_min = now | minus: since_s | divided_by: 60 -%}
  {%- if dur_min < 60 -%}{%- capture since_dur %}{{ dur_min }} min{% endcapture -%}
  {%- elsif dur_min < 1440 -%}{%- capture since_dur %}{{ dur_min | divided_by: 60 }}u {{ dur_min | modulo: 60 }}m{% endcapture -%}
  {%- else -%}{%- assign dur_d = dur_min | divided_by: 1440 -%}{%- capture since_dur %}{{ dur_d }} {% if dur_d == 1 %}dag{% else %}dagen{% endif %}{% endcapture -%}
  {%- endif -%}
{%- endif -%}

{%- assign added = '' -%}
{%- if charge_energy_added -%}{%- assign added = charge_energy_added | plus: 0 | round: 1 | append: '' | replace: '.', ',' -%}{%- endif -%}
{%- assign full_min = time_to_full_charge | plus: 0 | times: 60 | round -%}
{%- assign full_h = full_min | divided_by: 60 -%}
{%- assign full_m = full_min | modulo: 60 -%}
{%- assign full_at = full_min | times: 60 | plus: now | plus: tz | date: '%H:%M' -%}

{%- assign has_security = false -%}
{%- if locked or sentry_mode or is_climate_on -%}{%- assign has_security = true -%}{%- endif -%}

{%- comment %} gauge: charging power, or speed while driving {%- endcomment %}
{%- assign show_gauge = false -%}
{%- if is_charging -%}
  {%- assign show_gauge = true -%}
  {%- assign g_max = 11 -%}{%- if kw > 22 -%}{%- assign g_max = 250 -%}{%- elsif kw > 11 -%}{%- assign g_max = 22 -%}{%- endif -%}
  {%- assign g_frac = kw | times: 1.0 | divided_by: g_max -%}
{%- elsif is_driving -%}
  {%- assign show_gauge = true -%}
  {%- assign g_frac = speed_kmh | times: 1.0 | divided_by: 160 -%}
{%- endif -%}

{%- capture i_lock %}<svg viewBox="0 0 16 16"><rect x="3" y="7" width="10" height="7" rx="1.6"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/></svg>{% endcapture -%}
{%- capture i_unlock %}<svg viewBox="0 0 16 16"><rect x="3" y="7" width="10" height="7" rx="1.6"/><path d="M5.5 7V5a2.5 2.5 0 0 1 4.8-1"/></svg>{% endcapture -%}
{%- capture i_shield %}<svg viewBox="0 0 16 16"><path d="M8 1.8l5 2v4c0 3.2-2.2 5.3-5 6.4-2.8-1.1-5-3.2-5-6.4v-4z"/><circle cx="8" cy="7.6" r="1.6"/></svg>{% endcapture -%}
{%- capture i_fan %}<svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="1.4"/><path d="M8 6.6C8 4 9 2.3 10.6 2.6c1.5.3 1 2.6-1.4 4.6M9.4 8.6c2.3 1.3 3.3 3 2.3 4.3-1 1.1-2.9-.4-3.4-3.4M6.7 8.6c-2.3 1.2-4.3 1-4.5-.6-.2-1.5 2.1-2.1 4.7-.9"/></svg>{% endcapture -%}
{%- capture i_plug %}<svg viewBox="0 0 16 16"><path d="M6 1.8v3.2M10 1.8v3.2M4.5 5h7v2.5a3.5 3.5 0 0 1-7 0zM8 11v3.2"/></svg>{% endcapture -%}
{%- capture i_wheel %}<svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6"/><circle cx="8" cy="8" r="1.6"/><path d="M2.3 7h4.1M9.6 7h4.1M8 9.6V14"/></svg>{% endcapture -%}
{%- capture i_chip %}<svg viewBox="0 0 16 16"><rect x="4" y="4" width="8" height="8" rx="1.5"/><path d="M6 2v2M10 2v2M6 12v2M10 12v2M2 6h2M2 10h2M12 6h2M12 10h2"/></svg>{% endcapture -%}
{%- capture i_bolt %}<svg viewBox="0 0 10 10"><path d="M6 0.5 L1.5 5.6 H4.6 L3.8 9.5 L8.5 4.2 H5.4 Z"/></svg>{% endcapture -%}

{%- comment %} ================= screen ================= {%- endcomment %}
<div class="layout">
<div class="tm">

  <div class="card car">
    <div class="name">{{ display_name | default: 'Tesla' }}</div>
    <div class="st">Model {{ model | default: '3' }}</div>
    <div class="floor"></div>
    <img class="image image-dither" src="https://trmnl.achtnegen.nl/tesla/auto-blauw.png" alt="">
    <div class="state">
      <span class="badge badge--dark">{% if is_charging %}{{ i_bolt }}{% endif %}{{ state_label }}{% if place != '' %} · {{ place }}{% endif %}</span>
      {%- if age_label != '' %}<span class="badge badge--line">{{ age_label }}</span>{% endif %}
    </div>
  </div>

  <div class="card bat">
    <div class="t">Batterij</div>
    <div class="st">{% if is_charging %}Laadt naar {{ limit }}%{% elsif is_driving %}Onderweg{% else %}Lading{% endif %}</div>
    <div class="ring">
      <svg data-ring="dots" data-value="{{ level }}" viewBox="0 0 160 160"></svg>
      <div class="mid">
        <div class="delta"></div>
        <div class="num">{{ level }}<sup>%</sup></div>
        <div class="cap">{% if usable_battery_level %}{{ usable_battery_level }}% bruikbaar{% else %}lading{% endif %}</div>
      </div>
    </div>
    <div class="legend">{% if is_charging and added != '' %}+{{ added }} kWh deze sessie{% elsif is_charging %}Stekker erin{% elsif plugged_in == 'true' %}Stekker erin{% elsif plugged_in == 'false' %}Niet aangesloten{% endif %}</div>
  </div>

  <div class="kpis">
    <div class="card kpi">
      <div class="t">Actieradius</div>
      <div class="krow"><span class="num">{{ range_km }}<small>km</small></span>{% if est_battery_range_km %}<span class="badge badge--soft">{{ est_battery_range_km | plus: 0 | round }} km geschat</span>{% endif %}</div>
      <div class="dots" data-on="{{ level }}"></div>
    </div>

    <div class="card kpi">
      {%- if is_charging and full_min > 0 %}
      <div class="t">Vol om</div>
      <div class="krow"><span class="num">{{ full_at }}</span><span class="badge badge--dark">nog {% if full_h > 0 %}{{ full_h }}u {% endif %}{{ full_m }}m</span></div>
      <div class="dots" data-on="{{ level }}"></div>
      {%- elsif is_charging %}
      <div class="t">Laadt tot</div>
      <div class="krow"><span class="num">{{ limit }}<small>%</small></span><span class="badge badge--dark">nog {{ limit | minus: level }}%</span></div>
      <div class="dots" data-on="{{ level }}"></div>
      {%- elsif is_driving %}
      <div class="t">Vermogen</div>
      <div class="krow"><span class="num">{{ pwr }}<small>kW</small></span><span class="badge badge--soft">{% if pwr < 0 %}regeneratief{% else %}verbruik{% endif %}</span></div>
      <div class="dots" data-on="{{ pwr | abs | times: 100 | divided_by: 150 }}"></div>
      {%- else %}
      {%- if since_label != '' %}
      <div class="t">{{ state_label }} sinds</div>
      <div class="krow"><span class="num">{{ since_label }}</span><span class="badge badge--soft">{{ since_dur }}</span></div>
      {%- else %}
      <div class="t">Bijgewerkt</div>
      <div class="krow"><span class="num">{{ fetched_at | default: '-' }}</span></div>
      {%- endif %}
      <div class="dots" data-on="0"></div>
      {%- endif %}
    </div>

    <div class="card kpi">
      <div class="t">Software</div>
      <div class="krow"><span class="num">{{ version | default: '-' | split: ' ' | first }}</span>{% if update_available == 'true' %}<span class="badge badge--dark">update klaar</span>{% endif %}</div>
      <div class="dots" data-on="100"></div>
    </div>
  </div>

  <div class="bottom {% unless show_gauge %}bottom--nogauge{% endunless %}">
    {%- if show_gauge %}
    <div class="card gauge">
      {%- if is_charging %}
      <div class="t">Laadvermogen</div>
      <div class="st">{% if charger_actual_current %}{{ charger_actual_current }}A{% if charger_phases %} × {{ charger_phases }} fasen{% endif %}{% elsif kw > 22 %}snelladen{% else %}thuisladen{% endif %}</div>
      <div class="ring">
        <svg data-ring="ticks" data-value="{{ g_frac | times: 100 }}" viewBox="0 0 160 160"></svg>
        <div class="mid"><div class="delta">{% if volts > 0 %}{{ volts }} V{% endif %}</div><div class="num">{{ kw }}<small>kW</small></div></div>
      </div>
      {%- else %}
      <div class="t">Snelheid</div>
      <div class="st">Onderweg</div>
      <div class="ring">
        <svg data-ring="ticks" data-value="{{ g_frac | times: 100 }}" viewBox="0 0 160 160"></svg>
        <div class="mid"><div class="delta">km/u</div><div class="num">{{ speed_kmh }}</div></div>
      </div>
      {%- endif %}
    </div>
    {%- endif %}

    <div class="card slist">
      <div class="t">Status</div>
      {%- if has_security %}
      <div class="srow"><span class="ico {% if locked == 'true' %}ico--on{% endif %}">{% if locked == 'false' %}{{ i_unlock }}{% else %}{{ i_lock }}{% endif %}</span>
        <div class="tx"><b>Vergrendeld</b><span>{% if doors_open == 'true' %}Deur open{% elsif trunk_open == 'true' %}Kofferbak open{% elsif frunk_open == 'true' %}Frunk open{% elsif windows_open == 'true' %}Raam open{% else %}Alle deuren en ramen dicht{% endif %}</span></div>
        <span class="badge {% if locked == 'false' %}badge--soft{% else %}badge--dark{% endif %}">{% if locked == 'false' %}Open{% else %}Op slot{% endif %}</span></div>
      <div class="srow"><span class="ico {% if sentry_mode == 'true' %}ico--on{% endif %}">{{ i_shield }}</span>
        <div class="tx"><b>Sentry</b><span>{% if sentry_mode == 'true' %}Camera's kijken mee{% else %}Uitgeschakeld{% endif %}</span></div>
        <span class="badge {% if sentry_mode == 'true' %}badge--dark{% else %}badge--soft{% endif %}">{% if sentry_mode == 'true' %}Aan{% else %}Uit{% endif %}</span></div>
      <div class="srow"><span class="ico {% if is_climate_on == 'true' %}ico--on{% endif %}">{{ i_fan }}</span>
        <div class="tx"><b>Klimaat</b><span>{% if is_preconditioning == 'true' %}Voorverwarmen{% elsif is_climate_on == 'true' %}Ingeschakeld{% else %}Uitgeschakeld{% endif %}</span></div>
        <span class="badge {% if is_climate_on == 'true' %}badge--dark{% else %}badge--soft{% endif %}">{% if is_climate_on == 'true' %}Aan{% else %}Uit{% endif %}</span></div>
      {%- else %}
      <div class="srow"><span class="ico {% if is_charging %}ico--on{% endif %}">{{ i_plug }}</span>
        <div class="tx"><b>Lader</b><span>{% if is_charging %}{{ kw }} kW{% if volts > 0 %} · {{ volts }} V{% endif %}{% else %}Niet aan het laden{% endif %}</span></div>
        <span class="badge {% if is_charging %}badge--dark{% else %}badge--soft{% endif %}">{% if is_charging %}Laadt{% else %}Uit{% endif %}</span></div>
      <div class="srow"><span class="ico {% if is_driving %}ico--on{% endif %}">{{ i_wheel }}</span>
        <div class="tx"><b>Rijden</b><span>{% if is_driving %}{{ speed_kmh }} km/u · {{ pwr }} kW{% else %}Staat stil{% if place != '' %} bij {{ place }}{% endif %}{% endif %}</span></div>
        <span class="badge {% if is_driving %}badge--dark{% else %}badge--soft{% endif %}">{% if is_driving %}Rijdt{% else %}Stil{% endif %}</span></div>
      <div class="srow"><span class="ico {% if state == 'asleep' %}{% else %}ico--on{% endif %}">{{ i_chip }}</span>
        <div class="tx"><b>Verbinding</b><span>{% if age_label != '' %}Data {{ age_label }}{% else %}TeslaMate{% endif %}</span></div>
        <span class="badge {% if state == 'asleep' or state == 'offline' %}badge--soft{% else %}badge--dark{% endif %}">{% if state == 'asleep' %}Slaapt{% elsif state == 'offline' %}Offline{% else %}Online{% endif %}</span></div>
      {%- endif %}
    </div>

    <div class="stack">
      <div class="card mini">
        <div class="t">Binnen</div>
        <div class="inner"><div class="num">{{ t_in }}°</div><span>buiten {{ t_out }}°</span></div>
      </div>
      <div class="card mini">
        <div class="t">Km-stand</div>
        <div class="inner"><div class="num">{{ odo_km | number_with_delimiter: '.' }}</div><span>kilometer</span></div>
      </div>
    </div>

    <div class="card tyres">
      <div class="t">Banden</div>
      <div class="st">{% if tpms_pressure_fl %}bar{% if tpms_soft_warning_fl == 'true' or tpms_soft_warning_fr == 'true' or tpms_soft_warning_rl == 'true' or tpms_soft_warning_rr == 'true' %} · let op{% else %} · alles in orde{% endif %}{% else %}geen bandendata{% endif %}</div>
      <svg viewBox="0 0 150 112">
        <g fill="#000"><rect x="52.5" y="19" width="4" height="15" rx="1.5"/><rect x="93.5" y="19" width="4" height="15" rx="1.5"/><rect x="52.5" y="79" width="4" height="15" rx="1.5"/><rect x="93.5" y="79" width="4" height="15" rx="1.5"/></g>
        <path d="M75 4 C85 4 91.5 6.5 93.2 13 C94.6 19 95.6 25 95.4 33 C95 46 94.4 58 94.8 70 C95.2 80 95.8 90 93.6 98 C91.5 105 84 107 75 107 C66 107 58.5 105 56.4 98 C54.2 90 54.8 80 55.2 70 C55.6 58 55 46 54.6 33 C54.4 25 55.4 19 56.8 13 C58.5 6.5 65 4 75 4 Z" fill="#fff" stroke="#000" stroke-width="1.5"/>
