<script>
  (function () {
    var NS = 'http://www.w3.org/2000/svg';
    function el(tag, attrs) { var e = document.createElementNS(NS, tag); for (var k in attrs) e.setAttribute(k, attrs[k]); return e; }

    // battery: two dotted rings, solid up to the charge level, hollow after
    document.querySelectorAll('[data-ring="dots"]').forEach(function (svg) {
      var level = parseFloat(svg.dataset.value) || 0;
      [{ r: 72, n: 44, size: 3.2 }, { r: 60, n: 36, size: 1.6 }].forEach(function (ring) {
        for (var i = 0; i < ring.n; i++) {
          var pct = (i / ring.n) * 100, a = (i / ring.n) * Math.PI * 2 - Math.PI / 2, on = pct < level;
          svg.appendChild(el('circle', { cx: 80 + ring.r * Math.cos(a), cy: 80 + ring.r * Math.sin(a), r: on ? ring.size : ring.size * 0.6,
            fill: on ? '#000' : '#fff', stroke: '#000', 'stroke-width': on ? 0 : 0.8 }));
        }
      });
    });

    // gauge: tick ring, long thick ticks up to the value, short thin ones after
    document.querySelectorAll('[data-ring="ticks"]').forEach(function (svg) {
      var frac = Math.min(1, (parseFloat(svg.dataset.value) || 0) / 100), n = 64;
      for (var i = 0; i < n; i++) {
        var a = (i / n) * Math.PI * 2 - Math.PI / 2, on = i / n < frac, r1 = 74, r2 = on ? (i % 8 === 0 ? 60 : 64) : 69;
        svg.appendChild(el('line', { x1: 80 + r1 * Math.cos(a), y1: 80 + r1 * Math.sin(a), x2: 80 + r2 * Math.cos(a), y2: 80 + r2 * Math.sin(a),
          stroke: '#000', 'stroke-width': on ? 2 : 1, 'stroke-linecap': 'round' }));
      }
    });

    // progress bars: solid bars up to the value, tiny dots after
    document.querySelectorAll('.tm .dots').forEach(function (d) {
      var on = parseFloat(d.dataset.on) || 0, n = 44;
      for (var i = 0; i < n; i++) { var s = document.createElement('span'); if ((i / n) * 100 < on) s.className = 'on'; d.appendChild(s); }
    });
  })();
</script>
