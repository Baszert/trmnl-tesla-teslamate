<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<style>
  #app { font-family: 'Host Grotesk', sans-serif; }
  .bold { font-weight: bold; }
  .relative { position: relative; }
  .chartPosition { position: absolute; left: 0; }
  .chartPosition--center { bottom: 25%; }
  .absolute { position: absolute; top: 15px; right: 15px; }
</style>

<div id="app" class="layout">
  <div class="grid gap grid--cols-4 h--full"> 
    <div class="col--span-2 w--full">
      <div class="grid grid--cols-2 gap">
      
        <div class="bg--gray-75 col--span-1 p--4 rounded relative flex flex--col flex--left flex--bottom">
          <span class="h--full w--full text--right value--xsmall text-stroke text-stroke--xlarge">
            <i class="fa-solid fa-road"></i>
          </span>

          <div class="value--xxxsmall bold text-stroke text-stroke--large">
            Actieradius
          </div>
          <div class="value--small text-stroke text-stroke--large value--tnums bold">
            {{ rated_battery_range_km | round }}
            <small class="value value--xxsmall">km</small>
          </div>
        </div>

        <div class="bg--gray-75 col--span-1 p--4 rounded relative flex flex--col flex--left flex--bottom">
          <span class="h--full w--full text--right value--xsmall text-stroke text-stroke--xlarge">
            {% assign s = state | downcase %}

            {% case s %}
              {% when "online" %}
                <i class="fa-solid fa-signal"></i>
            
              {% when "driving" %}
                <i class="fa-solid fa-car-on"></i>
            
              {% when "charging" %}
                <i class="fa-solid fa-charging-station"></i>
            
              {% when "offline" %}
                <i class="fa-regular fa-face-frown"></i>
            
              {% when "asleep" %}
                <i class="fa-solid fa-bed"></i>
            
              {% when "updating" %}
                <i class="fa-solid fa-rotate"></i>

              {% when "suspended" %}
                <i class="fa-solid fa-skull-crossbones"></i>
    
              {% else %}
                <i class="fa-solid fa-question"></i>
            {% endcase %}
          </span>

          <div class="value--xxxsmall bold text-stroke text-stroke--large">
            Status
          </div>
          <div class="value--small text-stroke text-stroke--large value--tnums bold">
            {{ state | capitalize }}
          </div>
        </div>

        <div class="bg--gray-75 col--span-1 p--4 rounded relative flex flex--col flex--left flex--bottom">
          <span class="h--full w--full text--right value--xsmall text-stroke text-stroke--xlarge">
            <i class="fa-solid fa-plug"></i>
          </span>

          <div class="value--xxxsmall bold text-stroke text-stroke--large">
            Laadspanning
          </div>
          <div class="value--small text-stroke text-stroke--large value--tnums bold">
            {{ charger_voltage }}
            <small class="value value--xxsmall">V</small>
          </div>
        </div>

        <div class="bg--gray-75 col--span-1 p--4 rounded relative flex flex--col flex--left flex--bottom">
          <span class="h--full w--full text--right value--xsmall text-stroke text-stroke--xlarge">
            <i class="fa-solid fa-bolt"></i>
          </span>

          <div class="value--xxxsmall bold text-stroke text-stroke--large">
            Laadvermogen
          </div>
          <div class="value--small text-stroke text-stroke--large value--tnums bold">
            {{ charger_power }}
            <small class="value value--xxsmall">kW</small>
          </div>
        </div>

        <div class="bg--gray-75 col--span-1 p--4 rounded relative flex flex--col flex--left flex--bottom">
          <span class="h--full w--full text--right value--xsmall text-stroke text-stroke--xlarge">
            <i class="fa-solid fa-gauge-high"></i>
          </span>

          <div class="value--xxxsmall bold text-stroke text-stroke--large">
            Kilometerstand
          </div>
          <div class="value--small text-stroke text-stroke--large value--tnums bold">
            {{ odometer | round }}
            <small class="value value--xxsmall">km</small>
          </div>
        </div>

        <div class="bg--gray-75 col--span-1 p--4 rounded relative flex flex--col flex--left flex--bottom">
          <span class="h--full w--full text--right value--xsmall text-stroke text-stroke--xlarge">
            <i class="fa-solid fa-folder-open"></i>
          </span>

          <div class="value--xxxsmall bold text-stroke text-stroke--large">
            Software versie
          </div>
          <div class="value--small text-stroke text-stroke--large value--tnums bold">
            {{ version }}
          </div>
        </div>

      </div>
    </div>
    <div class="relative col--span-2 h--full w--full bg--black text--white p--4 rounded relative flex flex--col flex--left flex--bottom">
      <div class="value--small h--full w--full text--right absolute">
          {% assign level = battery_level | plus: 0 %}
          
          {% if level >= 90 %}
            <i class="fa-solid fa-battery-full"></i>
          {% elsif level >= 60 %}
            <i class="fa-solid fa-battery-three-quarters"></i>
          {% elsif level >= 40 %}
            <i class="fa-solid fa-battery-half"></i>
          {% elsif level >= 15 %}
            <i class="fa-solid fa-battery-quarter"></i>
          {% else %}
            <i class="fa-solid fa-battery-empty"></i>
          {% endif %}
      </div>
      <img src="https://trmnl.achtnegen.nl/tesla/auto-blauw.png" class="image w--[200%] image-dither absolute" style="top: -40px; left: 0;">
      <div class="value--xxxsmall bold text-stroke text-stroke--large text-stroke--black relative">
        Batterij
      </div>
      <div class="value--large value--tnums bold relative text-stroke text-stroke--large text-stroke--black relative">
        {{ battery_level }} <small class="value value--xsmall">%</small>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <svg fill="#000000" width="20" height="20" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
    <path fill="#FFFFFF" stroke="#FFFFFF" stroke-width="10" d="M16 7.151l3.302-4.036c0 0 5.656 0.12 11.292 2.74-1.443 2.182-4.307 3.25-4.307 3.25-0.193-1.917-1.536-2.385-5.807-2.385l-4.479 25.281-4.51-25.286c-4.24 0-5.583 0.469-5.776 2.385 0 0-2.865-1.057-4.307-3.24 5.635-2.62 11.292-2.74 11.292-2.74l3.302 4.031h-0.005zM16 1.953c4.552-0.042 9.766 0.703 15.104 3.036 0.714-1.292 0.896-1.859 0.896-1.859-5.833-2.313-11.297-3.109-16-3.13-4.703 0.021-10.167 0.813-16 3.13 0 0 0.26 0.703 0.896 1.865 5.339-2.344 10.552-3.083 15.104-3.047z"/>
    <path fill="#000000" d="M16 7.151l3.302-4.036c0 0 5.656 0.12 11.292 2.74-1.443 2.182-4.307 3.25-4.307 3.25-0.193-1.917-1.536-2.385-5.807-2.385l-4.479 25.281-4.51-25.286c-4.24 0-5.583 0.469-5.776 2.385 0 0-2.865-1.057-4.307-3.24 5.635-2.62 11.292-2.74 11.292-2.74l3.302 4.031h-0.005zM16 1.953c4.552-0.042 9.766 0.703 15.104 3.036 0.714-1.292 0.896-1.859 0.896-1.859-5.833-2.313-11.297-3.109-16-3.13-4.703 0.021-10.167 0.813-16 3.13 0 0 0.26 0.703 0.896 1.865 5.339-2.344 10.552-3.083 15.104-3.047z"/>
  </svg>
  <span class="title">{{ display_name }}</span>
</div>